# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit your real API key.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use for generation. openai/gpt-oss-20b is fast and free-tier friendly.
# (Groq deprecated the older llama-3.1/3.3 chat models — this is the current
# recommended lightweight model as of mid-2026.)
GROQ_MODEL=openai/gpt-oss-20b

# Embedding model — runs locally, no API key needed.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the vector database is stored on disk.
CHROMA_PATH=./chroma_db
COLLECTION_NAME=handbook

# Chunking settings (in words).
CHUNK_SIZE=220
CHUNK_OVERLAP=40

# How many chunks to retrieve per question.
TOP_K=4

# Path to the handbook PDF to ingest.
HANDBOOK_PATH=./data/handbook.pdf

# ZAIO website to crawl as a second knowledge source.
WEBSITE_URL=https://www.zaio.io
# Maximum number of same-domain pages to crawl (keeps the crawl bounded and polite).
WEBSITE_MAX_PAGES=12
